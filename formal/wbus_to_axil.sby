[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 12

[engines]
smtbmc

[script]
ghdl --std=08 -gG_ADDR_BITS=4 -gG_DATA_BITS=16 wbus_to_axil.vhd wbus_to_axil.psl -e wbus_to_axil
prep -top wbus_to_axil

[files]
wbus_to_axil.psl
../src/converters/wbus_to_axil.vhd
