[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 9

[engines]
# The read-back check (f_slave) needs depth >= 10 to cover a cache fill
# followed by an overlapping write burst and a read hit. abc bmc3 checks
# this depth much faster than smtbmc; cover mode requires smtbmc.
bmc: abc bmc3
cover: smtbmc

[script]
ghdl --std=08 -gG_BURST_BITS=4 -gG_CACHE_SIZE=4 -gG_ADDR_BITS=4 -gG_DATA_BITS=16 avm_readahead.vhd avm_readahead.psl -e avm_readahead
prep -top avm_readahead

[files]
avm_readahead.psl
../src/avm/avm_readahead.vhd

