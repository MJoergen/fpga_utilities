[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 10

[engines]
smtbmc

[script]
ghdl --std=08 -gG_ADDR_BITS=4 -gG_DATA_BITS=16 -gG_BURST_BITS=3 avm_to_wbus.vhd avm_to_wbus.psl -e avm_to_wbus
prep -top avm_to_wbus

[files]
avm_to_wbus.psl
../src/converters/avm_to_wbus.vhd
