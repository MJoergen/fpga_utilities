vunit axil_to_wbus_inst(axil_to_wbus(rtl))
{
-- set all declarations to run on clk
   default clock is rising_edge(clk_i);

   signal f_request_active : boolean;
   f_request_active_proc : process (clk_i)
   begin
     if rising_edge(clk_i) then
       if m_cyc_o and m_stb_o and not m_stall_i then
         f_request_active <= true;
       end if;
       if m_ack_i or not m_cyc_o then
         f_request_active <= false;
       end if;
       if rst_i = '1' then
         f_request_active <= false;
       end if;
     end if;
   end process f_request_active_proc;


------------------------------------------------
-- PROPERTIES OF THE MASTER INTERFACE
------------------------------------------------

-- WISHBONE MASTER: Clear all requests after a reset
   f_wbus_master_reset : assert always {rst_i} |=> {not m_cyc_o and not m_stb_o};

-- WISHBONE MASTER: STB must be low when CYC is low.
   f_wbus_master_stb_low : assert always {not m_cyc_o and not rst_i} |-> {not m_stb_o};

-- WISHBONE MASTER: Outputs must be stable during request
   f_wbus_master_stable : assert always {m_stb_o and not rst_i} |=>
     {stable(m_addr_o) and stable(m_wrdat_o) and stable(m_we_o)};

-- WISHBONE MASTER: Outputs must be stable during stall, unless the cycle is aborted
-- (CYC deasserted), e.g. on timeout.
  f_wbus_master_stall : assert always {m_cyc_o and m_stb_o and m_stall_i and not rst_i} |=>
    {m_cyc_o = '0' or (stable(m_stb_o) and stable(m_addr_o) and stable(m_wrdat_o) and stable(m_we_o))};


------------------------------------------------
-- PROPERTIES OF THE AXI LITE SLAVE INTERFACE
------------------------------------------------

-- AXI LITE SLAVE: Write response must be stable until accepted
   f_axil_slave_b_stable : assert always {s_bvalid_o and not s_bready_i and not rst_i} |=>
     {stable(s_bvalid_o) and stable(s_bresp_o)};

-- AXI LITE SLAVE: Read response must be stable until accepted
   f_axil_slave_r_stable : assert always {s_rvalid_o and not s_rready_i and not rst_i} |=>
     {stable(s_rvalid_o) and stable(s_rdata_o) and stable(s_rresp_o)};

-- AXI LITE SLAVE: A write acknowledged by the Wishbone slave returns OKAY
   f_axil_slave_b_okay : assert always {state = WRITING_ST and m_ack_i = '1' and rst_i = '0'} |=>
     {s_bvalid_o = '1' and s_bresp_o = "00"};

-- AXI LITE SLAVE: A read acknowledged by the Wishbone slave returns OKAY
   f_axil_slave_r_okay : assert always {state = READING_ST and m_ack_i = '1' and rst_i = '0'} |=>
     {s_rvalid_o = '1' and s_rresp_o = "00"};


-----------------------------
-- ASSUMPTIONS ABOUT INPUTS
-----------------------------

-- Require reset at startup.
   f_reset : assume {rst_i};

-- WISHBONE SLAVE: Respond within at least 1 clock cycle.
   f_wbus_slave_ack_delay_min : assume always {m_ack_i} |-> {f_request_active};


--------------------------------------------
-- COVER STATEMENTS TO VERIFY REACHABILITY
--------------------------------------------

-- A request is generated and accepted
   f_wbus_request : cover {m_stb_o and not rst_i; not m_stb_o};

 -- A request is generated and a response is received
   f_wbus_transaction : cover {f_request_active and rst_i = '0'; not f_request_active};

-- A request times out, and the error response is held while back-pressured
   f_axil_timeout : cover {s_bvalid_o = '1' and s_bresp_o = "10" and s_bready_i = '0' and rst_i = '0';
                           s_bvalid_o = '1' and s_bresp_o = "10"};


----------------------------------------------
-- ADDITIONAL ASSUMES HELPFUL WHEN DEBUGGING
----------------------------------------------

} -- vunit vunit axil_to_wbus_inst(axil_to_wbus(rtl))

