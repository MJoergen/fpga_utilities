[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 10

[engines]
smtbmc

[script]
ghdl --std=08 -gG_ADDR_BITS=4 -gG_DATA_BITS=16 -gG_BURST_BITS=3 wbus_to_avm.vhd wbus_to_avm.psl -e wbus_to_avm
prep -top wbus_to_avm

[files]
wbus_to_avm.psl
../src/converters/wbus_to_avm.vhd
